# SafeRoute Environment Configuration
# Copy this file to .env and update the values

# Server Port
PORT=5000

# MongoDB Connection URI
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/saferoute

# For MongoDB Atlas (optional):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/saferoute

# JWT Secret (change this to a long random string in production)
JWT_SECRET=saferoute_super_secret_jwt_key_change_in_production

# JWT Expiry
JWT_EXPIRES_IN=7d

# OSRM Routing Server
# Public demo server (no API key required):
OSRM_BASE_URL=https://router.project-osrm.org

# For local OSRM server:
# OSRM_BASE_URL=http://localhost:5000

# Node Environment
NODE_ENV=development
